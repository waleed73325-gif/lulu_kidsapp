@echo off
chcp 65001 > nul
title تشغيل خادم لولو التعليمي - Lulu Kids Backend
echo ======================================================================
echo          🚀 تشغيل خادم تطبيق لولو للأطفال (Lulu Kids Backend) 🚀
echo ======================================================================
echo.

:: 1. تفعيل إعادة توجيه المنافذ للأجهزة الحقيقية المتصلة بكابل USB عبر ADB
where adb >nul 2>&1
if %ERRORLEVEL% EQU 0 (
    echo [*] فحص أجهزة الأندرويد المتصلة بـ USB...
    adb reverse tcp:8000 tcp:8000 >nul 2>&1
    if %ERRORLEVEL% EQU 0 (
        echo [OK] تم تفعيل adb reverse بنجاح!
        echo      منفذ الخادم 8000 موجه مباشرة لهاتفك عبر كابل USB:
        echo      ^> http://127.0.0.1:8000/api/v1
    ) else (
        echo [i] لم يتم اكتشاف هاتف متصل حالياً عبر USB، لا بأس.
    )
) else (
    echo [!] لم يتم العثور على أداة adb في مسار النظام PATH.
)

echo.
echo ======================================================================
echo [*] بدء تشغيل الخادم على جميع واجهات الشبكة (0.0.0.0:8000)...
echo [i] الاتصال عبر شبكة الـ Wi-Fi:
echo     ^> http://192.168.1.101:8000/api/v1
echo [i] الاتصال المباشر من جهاز الكمبيوتر أو كابل USB:
echo     ^> http://127.0.0.1:8000/api/v1
echo ======================================================================
echo.

cd /d "%~dp0backend"
php artisan serve --host=0.0.0.0 --port=8000

echo.
echo [!] تم إيقاف الخادم.
pause

